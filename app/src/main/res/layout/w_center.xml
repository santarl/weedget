<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/img" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitCenter"/>
    <Chronometer android:id="@+id/chr" android:layout_width="match_parent"
        android:layout_height="match_parent" android:gravity="center" android:padding="12dp"
        android:textColor="#FFFFFF" android:textStyle="bold" android:singleLine="true" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="18sp"/>
    <TextView android:id="@+id/txt" android:layout_width="match_parent"
        android:layout_height="match_parent" android:gravity="center" android:padding="12dp"
        android:textColor="#FFFFFF" android:textStyle="bold" android:singleLine="true" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="18sp"/>
</FrameLayout>
