<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
    <ImageView android:id="@+id/dot" android:layout_width="10dp" android:layout_height="10dp"
        android:layout_marginEnd="8dp"/>
    <TextView android:id="@+id/rname" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="15sp"/>
    <Chronometer android:id="@+id/chr" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
    <TextView android:id="@+id/txt" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
</LinearLayout>
